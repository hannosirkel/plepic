{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".medusa/server",
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["medusa-config.ts", "src/**/*.ts", ".medusa/types/**/*.d.ts"],
  "exclude": ["node_modules", ".medusa/server", ".medusa/client", "tests", "vitest.config.ts"]
}
