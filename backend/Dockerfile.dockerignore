# The build context for `backend/Dockerfile`, which is the repository root.
#
# BuildKit reads this file because it is named after the Dockerfile and sits
# beside it; a plain `backend/.dockerignore` would be read only if the context
# were `backend/`, which it cannot be — the dependency tree comes from the
# workspace lockfile at the repository root. `scripts/images.test.ts` asserts
# the name.

# Build output and dependency trees. Every one of these is produced inside the
# image from the lockfile; a copy from the developer's machine would silently
# replace it with whatever that machine happens to have.
**/node_modules
**/.next
**/.next-test
**/.medusa
**/coverage
**/*.tsbuildinfo

# Version control, CI definitions and hooks. None of it is application code.
.git
.gitignore
.githooks
.github

# Tests, fixtures and the committed screenshot baselines. `scripts/validate`
# asserts that no test file survives into `.medusa/server`; excluding them from
# the context is what makes that true rather than incidental.
**/tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/vitest.config.ts
**/vitest.config.mts
**/playwright.config.ts

# Design masters. The repository commits web derivatives only — see the byte
# ceiling in `storefront/tests/no-live-hostname.test.ts` — and a master that
# ever does get committed by mistake must not also reach a published image.
**/*.psd
**/*.ai
**/*.sketch
**/*.fig
**/*.xcf
**/*.afdesign
**/*.afphoto
**/*.tif
**/*.tiff

# Prose, plans and local environment files.
**/*.md
docs
**/.env
**/.env.*

# The other workspace. Its `package.json` is re-included because npm reads
# every workspace manifest before it resolves anything, even when installing
# only this one.
storefront
!storefront/package.json
