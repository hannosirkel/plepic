{
  "name": "@plepic/storefront",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js App Router storefront serving the entire public site.",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "redirect-map:transform": "node --no-warnings --experimental-transform-types scripts/transform-redirect-map.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.mts",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@medusajs/js-sdk": "2.18.0",
    "@stripe/react-stripe-js": "6.8.1",
    "@stripe/stripe-js": "9.13.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.4",
    "stripe": "19.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
