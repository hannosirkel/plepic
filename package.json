{
  "name": "plepic",
  "version": "0.1.0",
  "private": true,
  "description": "Plepic Games storefront and backend monorepo",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "workspaces": [
    "storefront",
    "backend"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "rulebook:extract": "node rulebook/extract.ts",
    "rulebook:build": "node --import tsx rulebook/build.ts",
    "rulebook:check": "node --import tsx rulebook/check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/josefin-sans": "^5.3.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "lato-font": "^3.0.0",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
