#!/usr/bin/env bash
set -euo pipefail

plepic_medusa_config_dir="$(mktemp -d "${TMPDIR:-/tmp}/plepic-medusa-config.XXXXXX")"
trap 'rm -rf -- "${plepic_medusa_config_dir}"' EXIT

npm run lint
# The root tsconfig covers content/, design/ and scripts/ only, so the
# storefront's program is typechecked explicitly -- otherwise the seam's
# promise that the type checker enumerates a new locale's work is only
# enforced by CI for the content/ half.
npm run typecheck
npm run typecheck --workspace storefront
npm run typecheck --workspace backend
env \
  NODE_ENV=production \
  DATABASE_URL=postgres://app:password@database:5432/medusa \
  JWT_SECRET=validation-jwt-secret \
  COOKIE_SECRET=validation-cookie-secret \
  STORE_CORS=https://store.example.test \
  ADMIN_CORS=https://admin.example.test \
  AUTH_CORS=https://store.example.test \
  REDIS_HOST=redis.example.test \
  REDIS_PORT=6379 \
  REDIS_PASSWORD=validation-redis-password \
  STRIPE_SECRET_KEY=synthetic_validation \
  STRIPE_WEBHOOK_SECRET=whsec_validation \
  STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=pmc_validation \
  SMTP_HOST=smtp.example.test \
  SMTP_PORT=587 \
  SMTP_USERNAME=validation-smtp-user \
  SMTP_PASSWORD=validation-smtp-password \
  SMTP_FROM_NAME='Plepic Games Test' \
  SMTP_ENVELOPE_FROM=orders@example.test \
  CONTACT_MAIL_RECIPIENT=contact@example.test \
  TURNSTILE_SECRET_KEY=validation-turnstile-secret \
  MERCHANT_LEGAL_NAME='Example Games OÜ' \
  MERCHANT_REGISTERED_ADDRESS='Example Street 1, Tallinn' \
  MERCHANT_CONTACT_ADDRESS=legal@example.test \
  MERCHANT_RETURN_ADDRESS='Return Street 2, Tallinn' \
  MEDUSA_DISABLE_TELEMETRY=true \
  XDG_CONFIG_HOME="${plepic_medusa_config_dir}" \
  npm run build --workspace backend
test -s backend/.medusa/server/medusa-config.js
test -s backend/.medusa/server/src/config/runtime.js
test ! -e backend/.medusa/server/tests/runtime-config.test.js
# All four of the image's roles begin with `npm run redis:preflight`, and the
# `.js` branch of that script is the only one the image can take -- `ts-node` is
# a development dependency and `npm ci --omit=dev` leaves it out. So a build that
# failed to compile this one file would not fall back, it would crash-loop every
# workload on `Cannot find module 'ts-node'`, which is a confusing way to say
# that the Redis check is missing.
test -s backend/.medusa/server/src/config/redis-preflight.js
# Every workload in `hannosirkel/deploys` runs this one image and chooses what
# it does with `args: [npm, run, <script>]`. Kubernetes `args` replaces the
# image's `CMD`, so a manifest naming a script the built image does not declare
# is `npm ERR! Missing script` and an immediate exit -- with no failure mode
# before cutover.
#
# This assertion previously covered `catalogue:import` alone, which is exactly
# why that row was sound while `start:worker` and `predeploy` were merged as
# manifest `args` with no script behind them.
#
# **The list is declared, not derived.** Deriving it would mean reading the
# manifests, and they are in a repository this build cannot see: CI checks out
# `plepic` alone, and fetching another repository at validation time would make
# a green run depend on that repository's availability and on whatever happened
# to be on its `main` at that moment -- so a `deploys` commit could turn this
# build red with no change here. A declared list is checked by hand instead, and
# each entry names the manifest it comes from so that check is mechanical.
# `backend/tests/deployment-contract.test.ts` holds the same list against the
# *source* manifest; this holds it against the built artifact, which is the
# thing the cluster actually runs.
for cluster_invoked_script in \
  start `# deploys/plepic/base/backend.yaml` \
  start:worker `# deploys/plepic/base/worker.yaml` \
  predeploy `# deploys/plepic/base/predeploy-job.yaml` \
  catalogue:import `# deploys/plepic/base/import-job.yaml`; do
  node -e 'process.exit(
    require("./backend/.medusa/server/package.json").scripts[process.argv[1]] ? 0 : 1
  )' "${cluster_invoked_script}" ||
    { echo "the built image declares no \"${cluster_invoked_script}\" script" >&2; exit 1; }
done
# Every `medusa exec` script names a file, and the built image is the only place
# the compiled half of that name exists. The script-name loop above cannot see
# these: `predeploy` reaches three of them through `npm run`, so the manifest
# names `predeploy` and the file it ends up executing is one indirection away.
#
# **`configure-commerce.js` was missing from this list while its two siblings
# were on it,** which is the gap the fourth entry closes. The failure it left
# open is quiet and total: the `.ts` fallback in each script exists because a
# local checkout has only the source, so a build that failed to compile one of
# these files does not error — it silently takes the fallback branch and dies in
# the cluster on `Cannot find module 'ts-node'`, which `npm ci --omit=dev`
# leaves out of the image. That is the predeploy Job failing at wave -10, so the
# Argo CD Application never syncs and no workload starts.
test -s backend/.medusa/server/src/scripts/catalogue-import.js
test -s backend/.medusa/server/src/scripts/seed-administrator.js
test -s backend/.medusa/server/src/scripts/configure-commerce.js
test -s backend/.medusa/server/src/scripts/seed-product.js
npm run test:unit
